{
  "name": "one-shot",
  "label": "One-shot",
  "description": "Implements every story end-to-end in one continuous run. No external gates. Default.",
  "default": true,
  "sensors": [
    {
      "file": "eslint.config.js",
      "name": "eslint",
      "type": "debt",
      "package": "eslint",
      "guidance": "CHANGED=$(git diff --name-only \"$baseBranch\"...HEAD -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs'); [ -n \"$CHANGED\" ] && npx eslint --no-config-lookup -c .marmite/sensors/eslint.config.js $CHANGED"
    },
    {
      "file": ".dependency-cruiser.cjs",
      "name": "dependency-cruiser",
      "type": "drift",
      "package": "dependency-cruiser",
      "guidance": "CHANGED=$(git diff --name-only \"$baseBranch\"...HEAD -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs'); [ -n \"$CHANGED\" ] && npx depcruise --config .marmite/sensors/.dependency-cruiser.cjs $CHANGED"
    }
  ]
}
